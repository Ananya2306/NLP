    {
      "cell_type": "code",
      "source": [
        "import nltk\n",
        "from nltk import FreqDist, ConditionalFreqDist, Text\n",
        "from nltk.corpus import brown, stopwords\n",
        "from nltk.collocations import BigramCollocationFinder, BigramAssocMeasures\n",
        "\n",
        "for p in [\"brown\", \"stopwords\"]:\n",
        "   nltk.download(p, quiet=True)\n",
        "\n",
        "# 1. Corpus structure\n",
        "print(\"Genres :\", brown.categories())\n",
        "print(\"Words  :\", len(brown.words()), \"| Sentences:\", len(brown.sents()))\n",
        "\n",
        "# 2. Lexical diversity (type/token ratio) and average sentence length per genre\n",
        "print(f\"\\n{'genre':14}{'tokens':>9}{'types':>8}{'TTR':>8}{'avg sent len':>14}\")\n",
        "for g in [\"news\", \"religion\", \"fiction\", \"romance\", \"science_fiction\", \"learned\"]:\n",
        "     w = [x.lower() for x in brown.words(categories=g)]\n",
        "     avg = len(w) / len(brown.sents(categories=g))\n",
        "     print(f\"{g:14}{len(w):9}{len(set(w)):8}{len(set(w))/len(w):8.3f}{avg:14.1f}\")\n",
        "\n",
        "# 3. Frequency distribution and Zipf's law\n",
        "stop = set(stopwords.words(\"english\"))\n",
        "fd = FreqDist(w.lower()\n",
        "              for w in brown.words(categories=\"news\")\n",
        "                if w.isalpha())\n",
        "\n",
        "print(\"\\nTop 10 words:\", fd.most_common(10))\n",
        "print(\"Top 10 content words:\",\n",
        "      [(w, c) for w, c in fd.most_common(60)\n",
        "        if w not in stop][:10])\n",
        "print(\"Words occurring once (hapaxes): %.1f%% of vocabulary\"\n",
        "       % (100 * len(fd.hapaxes()) / len(fd)))\n",
        "\n",
        "for rank, (w, c) in enumerate(fd.most_common(5), 1):\n",
        "     print(f\"rank {rank}: {w:6} freq {c:6}  rank*freq = {rank*c}\")\n",
        "\n",
        "# 4. Concordance\n",
        "Text(brown.words(categories=\"news\")).concordance(\"government\", width=70, lines=5)\n",
        "\n",
        "# 5. Conditional frequency: modal verbs across genres\n",
        "modals = [\"can\", \"could\", \"may\", \"might\", \"must\", \"will\"]\n",
        "cfd = ConditionalFreqDist((g, w.lower()) for g in [\"news\", \"religion\", \"romance\", \"humor\"]\n",
        "                          for w in brown.words(categories=g))\n",
        "\n",
        "print()\n",
        "cfd.tabulate(conditions=[\"news\", \"religion\", \"romance\", \"humor\"], samples=modals)\n",
        "\n",
        "# 6. Collocations / multiword candidates using PMI\n",
        "words = [w.lower()\n",
        "        for w in brown.words(categories=\"news\")\n",
        "           if w.isalpha()]\n",
        "\n",
        "finder = BigramCollocationFinder.from_words(words)\n",
        "finder.apply_freq_filter(5)\n",
        "print(\"\\nTop PMI bigrams:\", finder.nbest(BigramAssocMeasures.pmi, 10))"
      ],
