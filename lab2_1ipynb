      "cell_type": "code",
      "source": [
        "from collections import Counter\n",
        "import nltk\n",
        "from nltk import Nonterminal, induce_pcfg\n",
        "from nltk.corpus import treebank\n",
        "from nltk.metrics.agreement import AnnotationTask\n",
        "\n",
        "for p in [\"treebank\"]:\n",
        "   nltk.download(p, quiet=True)\n",
        "\n",
        "# 1. Inspect a Penn Treebank sentence (phrase-structure annotation)\n",
        "tree = treebank.parsed_sents()[0]\n",
        "print(tree)\n",
        "print(\"Leaves :\", tree.leaves())\n",
        "print(\"Height :\", tree.height(), \"| NP subtrees:\", len(list(tree.subtrees(lambda t: t.label() == \"NP\"))))\n",
        "\n",
        "# 2. Corpus statistics: tag and phrase distributions\n",
        "tags = Counter(t for _, t in treebank.tagged_words())\n",
        "print(\"\\nTokens:\", sum(tags.values()), \"| distinct tags:\", len(tags))\n",
        "print(\"Top tags:\", tags.most_common(8))\n",
        "phrases = Counter(st.label() for t in treebank.parsed_sents()\n",
        "                   for st in t.subtrees() if st.height() > 2)\n",
        "print(\"Top phrase labels:\", phrases.most_common(6))\n",
        "\n",
        "# 3. Induce a PCFG from 200 trees (the treebank IS the grammar source)\n",
        "productions = []\n",
        "for t in treebank.parsed_sents()[:200]:\n",
        "       t = t.copy(deep=True)\n",
        "       t.collapse_unary(collapsePOS=False)\n",
        "       t.chomsky_normal_form(horzMarkov=2)\n",
        "       productions += t.productions()\n",
        "\n",
        "pcfg = induce_pcfg(Nonterminal(\"S\"), productions)\n",
        "print(\"\\nInduced PCFG with\", len(pcfg.productions()), \"productions. Rules for S:\")\n",
        "for p in pcfg.productions(Nonterminal(\"S\"))[:5]:\n",
        "       print(\"  \", p)\n",
        "\n",
        "# 4. Annotation quality - inter-annotator agreement (Cohen's kappa)\n",
        "#    Two annotators label the sentiment of 10 sentences\n",
        "a = [\"pos\",\"pos\",\"neg\",\"neu\",\"pos\",\"neg\",\"neg\",\"neu\",\"pos\",\"neu\"]\n",
        "b = [\"pos\",\"pos\",\"neg\",\"pos\",\"pos\",\"neg\",\"neu\",\"neu\",\"pos\",\"neg\"]\n",
        "data = [(\"A\", i, l) for i, l in enumerate(a)] + [(\"B\", i, l) for i, l in enumerate(b)]\n",
        "task = AnnotationTask(data=data)\n",
        "print(\"\\nObserved agreement : %.2f\" % task.avg_Ao())\n",
        "print(\"Cohen's kappa      : %.3f\" % task.kappa())"
      ],
