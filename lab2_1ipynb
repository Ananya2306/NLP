    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "import nltk\n",
        "from nltk import pos_tag\n",
        "from nltk.corpus import stopwords, wordnet\n",
        "from nltk.stem import WordNetLemmatizer, PorterStemmer\n",
        "from nltk.tokenize import word_tokenize, sent_tokenize\n",
        "\n",
        "for pkg in [\"punkt\", \"punkt_tab\", \"stopwords\", \"wordnet\", \"averaged_perceptron_tagger\", \"averaged_perceptron_tagger_eng\"]:\n",
        "  nltk.download(pkg)\n",
        "\n",
        "text = (\"Dr. Rao's team is building chatbots, translators and search engines! \"\n",
        "        \"The systems were running faster than expected. \"\n",
        "        \"Visit https://example.com or mail nlp@lab.edu for details.\")\n",
        "# Step 1: sentence segmentation (before lower-casing so that 'Dr.' is handled)\n",
        "sentences = sent_tokenize(text)\n",
        "print(\"Sentences:\", len(sentences))\n",
        "for s in sentences:\n",
        "       print(\"  -\", s)\n",
        "\n",
        " # Step 2: normalisation - remove URLs / e-mails, lower-case, strip punctuation\n",
        "def normalise(s):\n",
        "      s = re.sub(r\"https?://\\S+|\\S+@\\S+\", \" \", s)\n",
        "      return s.lower()\n",
        "\n",
        "  # Step 3: word tokenisation and stop-word removal\n",
        "stop = set(stopwords.words(\"english\"))\n",
        "tokens = [t for s in sentences for t in word_tokenize(normalise(s))]\n",
        "words = [t for t in tokens if t.isalpha()]\n",
        "content = [t for t in words if t not in stop]\n",
        "print(\"\\nTokens  :\", tokens)\n",
        "print(\"Content :\", content)\n",
        "\n",
        "# Step 4: stemming vs lemmatisation (POS-aware)\n",
        "ps, wnl = PorterStemmer(), WordNetLemmatizer()\n",
        "def to_wn(tag):\n",
        "      return {\"J\": wordnet.ADJ, \"V\": wordnet.VERB,\n",
        "               \"N\": wordnet.NOUN, \"R\": wordnet.ADV}.get(tag[0], wordnet.NOUN)\n",
        "\n",
        "print(f\"\\n{'word':12}{'stem':12}{'lemma':12}\")\n",
        "for w, tag in pos_tag(content):\n",
        "         print(f\"{w:12}{ps.stem(w):12}{wnl.lemmatize(w, to_wn(tag)):12}\")\n",
        "\n",
        "# Step 5: vocabulary reduction\n",
        "print(\"\\nVocabulary size  raw:\", len(set(words)),\n",
        "        \"| after stop-word removal:\", len(set(content)),\n",
        "        \"| after stemming:\", len({ps.stem(w) for w in content}))"
      ],
