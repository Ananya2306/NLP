        "EXPERIMENT 1.3 - AUTOMATIC EXTRACTIVE TEXT SUMMARISATION"
      ],
      "metadata": {
        "id": "LoyJUd55Gi8S"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "from collections import Counter\n",
        "import nltk\n",
        "from nltk.corpus import stopwords\n",
        "from nltk.tokenize import sent_tokenize, word_tokenize\n",
        "\n",
        "for p in [\"punkt\", \"punkt_tab\", \"stopwords\"]:\n",
        "   nltk.download(p, quiet=True)\n",
        "\n",
        "text = \"\"\"Natural language processing began in the 1950s with machine translation experiments.\n",
        "      Early systems relied on hand-written rules created by linguists.\n",
        "      These rule-based systems were accurate in narrow domains but difficult to scale.\n",
        "      In the 1990s statistical methods replaced many rules because large corpora became available.\n",
        "      Statistical models learn patterns of language from annotated text.\n",
        "      Today neural networks power translation, search and virtual assistants.\n",
        "      Modern language models are trained on billions of words.\n",
        "      The field continues to grow as new applications appear in education and health care.\"\"\"\n",
        "\n",
        "reference = (\"NLP moved from hand-written rules to statistical methods \"\n",
        "             \"and now to neural networks trained on large corpora.\")\n",
        "\n",
        "stop = set(stopwords.words(\"english\"))\n",
        "sents = sent_tokenize(text)\n",
        "\n",
        "# 1. Word-frequency table (content words only)\n",
        "words = [w.lower()\n",
        "        for w in word_tokenize(text)\n",
        "            if w.isalpha() and w.lower() not in stop]\n",
        "\n",
        "freq = Counter(words)\n",
        "maxf = max(freq.values())\n",
        "weight = {w: c / maxf for w, c in freq.items()}\n",
        "# normalised frequency\n",
        "\n",
        "# 2. Score each sentence = sum of word weights / length (avoids long-sentence bias)\n",
        "def score(sent):\n",
        "   ws = [w.lower()\n",
        "          for w in word_tokenize(sent)\n",
        "              if w.isalpha() and w.lower() not in stop]\n",
        "   return sum(weight.get(w, 0) for w in ws) / (len(ws) or 1)\n",
        "\n",
        "scores = {s: score(s) for s in sents}\n",
        "\n",
        "# 3. Pick the top-k sentences, keep original order\n",
        "def summarise(k=3):\n",
        "   top = sorted(sents, key=lambda s: scores[s], reverse=True)[:k]\n",
        "   return \" \".join(s for s in sents if s in top)\n",
        "\n",
        "summary = summarise(3)\n",
        "print(\"SUMMARY:\\n\", summary)\n",
        "print(\"\\nCompression ratio: %.2f\" % (len(summary.split()) / len(text.split())))\n",
        "\n",
        "# 4. ROUGE-1 (unigram overlap) against the reference summary\n",
        "def unigrams(t):\n",
        "   return Counter(re.findall(r\"[a-z]+\", t.lower()))\n",
        "\n",
        "ref, hyp = unigrams(reference), unigrams(summary)\n",
        "overlap = sum((ref & hyp).values())\n",
        "p, r = overlap / sum(hyp.values()), overlap / sum(ref.values())\n",
        "f = 2 * p * r / (p + r) if p + r else 0\n",
        "print(f\"ROUGE-1  P={p:.2f}  R={r:.2f}  F1={f:.2f}\")"
      ],
